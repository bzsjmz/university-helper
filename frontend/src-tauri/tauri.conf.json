{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "学道",
  "version": "1.5.0",
  "identifier": "io.github.bzsjmz.university-helper",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "splash"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "学道",
        "width": 480,
        "height": 320,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "dmg",
      "app",
      "appimage",
      "deb"
    ],
    "externalBin": [
      "binaries/uh-backend"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "./entitlements.plist",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/browsers/": "browsers/",
      "../../LICENSE": "licenses/UniversityHelper.LICENSE",
      "../../third_party/english-learning/": "licenses/english-learning/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/bzsjmz/university-helper/releases/latest/download/latest.json"
      ]
    }
  }
}
